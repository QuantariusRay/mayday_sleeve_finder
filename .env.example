# Copy to .env and fill in after creating a Supabase project.
# Without these, the app uses the checked-in mock seed (Expo Go works offline).

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — used by `npm run seed` (never put in the app bundle)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional alias used by the seed script:
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
