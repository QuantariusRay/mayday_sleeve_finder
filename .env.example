# Copy to .env and fill in after creating a Supabase project.
# Without these, the app uses the checked-in mock seed (Expo Go works offline).

# App (Expo reads these automatically after restart)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Seed script only (`npm run seed`) — service_role, NOT the anon key.
# Never commit this; never put it in EXPO_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: same URL under this name if you prefer
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
